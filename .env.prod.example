# Copie para .env.prod e preencha. Nunca commite o arquivo preenchido.
DOMAIN=compramais.exemplo.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-longa
SESSION_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
ANTHROPIC_API_KEY=
IMPORTER_MODEL=claude-opus-5-5
# Primeiro acesso: cria o admin se ainda não houver usuários
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Backup diário (pg_dump + storage) para S3; vazio guarda só no volume local
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
