{
  "name": "compramais",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "worker:dev": "tsx --env-file-if-exists=.env watch worker/index.ts",
    "predeploy": "tsx --env-file-if-exists=.env scripts/predeploy.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "vitest run --config vitest.ai.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/server/db/seed.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "import": "tsx --env-file-if-exists=.env scripts/import-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "next": "^16.4.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
